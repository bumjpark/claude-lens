# EC2 서버 위에서 이 파일을 복사해 `.env`로 만들고 실제 값을 채운다.
# (docker/docker-compose.prod.yml 이 이 .env를 읽는다. git에는 이 example 파일만 올라가고
#  실제 값이 든 .env는 절대 커밋하지 않는다.)

# ── Postgres ──
DB_USERNAME=claudelens
DB_PASSWORD=

# ── MongoDB ── (--auth 로 뜨므로 반드시 채워야 함)
MONGO_USERNAME=claudelens
MONGO_PASSWORD=

# ── AI 분석 엔진 ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── Backend JWT ── 로컬 기본값을 그대로 쓰지 말고 반드시 새로 생성한 강한 값으로 채울 것
# 예: openssl rand -base64 64
JWT_SECRET=

# ── CORS ── 프론트엔드가 실제로 서빙되는 origin(들)을 콤마로 구분해서 적는다.
# 예: http://<EC2 공인 IP>:3000,https://your-domain.com
CORS_ALLOWED_ORIGINS=

# ── Frontend 빌드 ── 브라우저에서 백엔드로 보낼 요청의 baseUrl. Vite 빌드 시점에 번들에
# 박히는 값이라(런타임에 안 바뀜) EC2 IP/도메인이 바뀌면 프론트를 다시 빌드해야 한다.
# 예: http://<EC2 공인 IP>:8080
VITE_API_BASE_URL=
